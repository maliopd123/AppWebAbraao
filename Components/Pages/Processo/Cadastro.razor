@page "/processos/cadastro"
@page "/processos/editar/{Id:int}"
@rendermode InteractiveServer

@using AppWebAbraao.Model
@using AppWebAbraao.DAO
@inject ProcessoDAO ProcessoDAO
@inject NavigationManager Navigation

<PageTitle>@Titulo - Sistema de Controle de Processos</PageTitle>

<div class="mb-4">
    <h2>@Titulo</h2>
    <p class="text-muted mb-0">Preencha os dados do processo.</p>
</div>

<div class="custom-table-card p-4">
    @if (erro is not null)
    {
        <div class="alert alert-danger" role="alert">@erro</div>
    }

    @if (Id.HasValue && !processoEncontrado && erro is null)
    {
        <div class="alert alert-warning" role="alert">
            Processo não encontrado.
            <a href="/processos" class="alert-link">Voltar para a lista</a>
        </div>
    }
    else if (!Id.HasValue || processoEncontrado)
    {
        <EditForm Model="processo" OnValidSubmit="Salvar" FormName="cadastro-processo">
            <DataAnnotationsValidator />

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label for="numero" class="form-label">Número</label>
                    <InputText id="numero" class="form-control" @bind-Value="processo.Numero" />
                    <ValidationMessage For="() => processo.Numero" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label for="data" class="form-label">Data</label>
                    <InputDate id="data" class="form-control" @bind-Value="processo.Data" />
                    <ValidationMessage For="() => processo.Data" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label for="situacao" class="form-label">Situação</label>
                    <InputSelect id="situacao" class="form-select" @bind-Value="processo.Situacao">
                        <option value="Aberto">Aberto</option>
                        <option value="Em analise">Em análise</option>
                        <option value="Pendente">Pendente</option>
                        <option value="Concluido">Concluído</option>
                        <option value="Arquivado">Arquivado</option>
                    </InputSelect>
                    <ValidationMessage For="() => processo.Situacao" class="text-danger small" />
                </div>
                <div class="col-12">
                    <label for="interessado" class="form-label">Interessado</label>
                    <InputText id="interessado" class="form-control" @bind-Value="processo.Interessado" />
                    <ValidationMessage For="() => processo.Interessado" class="text-danger small" />
                </div>
                <div class="col-12">
                    <label for="assunto" class="form-label">Assunto</label>
                    <InputText id="assunto" class="form-control" @bind-Value="processo.Assunto" />
                    <ValidationMessage For="() => processo.Assunto" class="text-danger small" />
                </div>
                <div class="col-12">
                    <label for="descricao" class="form-label">Descrição</label>
                    <InputTextArea id="descricao" class="form-control" rows="4" @bind-Value="processo.Descricao" />
                    <ValidationMessage For="() => processo.Descricao" class="text-danger small" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@salvando">
                @(salvando ? "Salvando..." : Id.HasValue ? "Atualizar" : "Salvar")
            </button>
            <a href="/processos" class="btn btn-light border ms-2">Cancelar</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private Processo processo = new();
    private string? erro;
    private bool salvando;
    private bool processoEncontrado = true;

    private string Titulo => Id.HasValue ? "Editar Processo" : "Cadastro de Processo";

    protected override void OnParametersSet()
    {
        erro = null;

        if (!Id.HasValue)
        {
            processo = new Processo();
            processoEncontrado = true;
            return;
        }

        processoEncontrado = false;
        try
        {
            var processoCarregado = ProcessoDAO.ObterPorId(Id.Value);
            if (processoCarregado is not null)
            {
                processo = processoCarregado;
                processoEncontrado = true;
            }
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar o processo. Verifique a conexão com o banco de dados.";
        }
    }

    private void Salvar()
    {
        if (salvando) return;

        salvando = true;
        erro = null;
        try
        {
            if (Id.HasValue)
            {
                ProcessoDAO.Atualizar(processo);
            }
            else
            {
                ProcessoDAO.Inserir(processo);
            }

            Navigation.NavigateTo("/processos");
        }
        catch (Exception)
        {
            erro = "Não foi possível salvar o processo. Verifique a conexão com o banco e tente novamente.";
            salvando = false;
        }
    }
}
